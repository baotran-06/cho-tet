{
  "kiss": [
    {
      "lines": [
        {
          "role": "groom",
          "text": "Cho anh mượn má một chút. Anh trả bằng cả tấm lòng.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 0,
          "at": 0.3,
          "duration": 4.32
        }
      ],
      "duration": 4.74
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Hôn nhẹ thôi anh, lớp nền này em đánh cả tiếng đó.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 4.5,
          "at": 0.3,
          "duration": 3.672
        }
      ],
      "duration": 4.092
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Má đã hồng, tim đã rung. Cả nhà cho đôi trẻ một tràng vỗ tay!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 8.352,
          "at": 0.3,
          "duration": 4.632
        }
      ],
      "duration": 5.052
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Anh không giỏi thả thính. Anh chỉ giỏi thương em.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 13.164,
          "at": 0.3,
          "duration": 4.104
        }
      ],
      "duration": 4.524
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Được rồi, em nhận nụ hôn. Còn trà sữa anh vẫn nợ nha.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 17.448,
          "at": 0.3,
          "duration": 4.896
        }
      ],
      "duration": 5.316
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Xin giữ bình tĩnh! Đây là đám cưới, không phải cuộc thi phát đường.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 22.524,
          "at": 0.3,
          "duration": 4.416
        }
      ],
      "duration": 4.836
    }
  ],
  "wedding": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Xin mời cả nhà hướng về sân khấu. Lễ thành hôn chính thức bắt đầu!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 27.12,
          "at": 0.3,
          "duration": 4.368
        }
      ],
      "duration": 4.788
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Từ hôm nay, tiền lương anh có nơi để về rồi.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 31.668,
          "at": 0.3,
          "duration": 3.216
        }
      ],
      "duration": 3.636
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Em đồng ý. Riêng mật khẩu điện thoại, mình bàn sau nha.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 35.064,
          "at": 0.3,
          "duration": 3.768
        }
      ],
      "duration": 4.188
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Một người trao nhẫn, một người trao cả thanh xuân. Xin chúc mừng đôi uyên ương!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 39.012,
          "at": 0.3,
          "duration": 4.872
        }
      ],
      "duration": 5.292
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Trước bao nhiêu người ở đây, anh chọn em. Hôm nay và cả những ngày sau.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 44.064,
          "at": 0.3,
          "duration": 5.232
        }
      ],
      "duration": 5.652
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Vậy từ mai anh rửa chén, em đứng cạnh cổ vũ nha.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 49.476,
          "at": 0.3,
          "duration": 3.72
        }
      ],
      "duration": 4.140000000000001
    }
  ],
  "bouquet": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Hội độc thân đâu rồi? Hoa cưới chuẩn bị cất cánh!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 53.376,
          "at": 0.3,
          "duration": 3.648
        }
      ],
      "duration": 4.068
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Em tung hoa thôi, không tung người yêu đâu nha!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 57.204,
          "at": 0.3,
          "duration": 3.24
        }
      ],
      "duration": 3.66
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Ai bắt được hoa, nhớ mời cả phòng này đi ăn cưới đó!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 60.624,
          "at": 0.3,
          "duration": 3.288
        }
      ],
      "duration": 3.7079999999999997
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Ba, hai, một! Duyên tới thì mình đừng né nha!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 64.092,
          "at": 0.3,
          "duration": 4.488
        }
      ],
      "duration": 4.908
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Bắt hoa bằng tay, đừng bắt bằng đầu nha cả nhà!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 68.76,
          "at": 0.3,
          "duration": 3.384
        }
      ],
      "duration": 3.804
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Hoa đã lên đường. Tình yêu đang tìm địa chỉ giao hàng!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 72.324,
          "at": 0.3,
          "duration": 3.864
        }
      ],
      "duration": 4.284
    }
  ],
  "celebrate": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Nhạc lên! Bàn nào vui nhất cho tôi thấy cánh tay nào!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 76.368,
          "at": 0.3,
          "duration": 3.744
        }
      ],
      "duration": 4.164000000000001
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Hôm nay vui quá, cô dâu xin phép quên luôn dáng dịu dàng!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 80.292,
          "at": 0.3,
          "duration": 3.72
        }
      ],
      "duration": 4.140000000000001
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Anh nhảy không đẹp. Nhưng được cái anh rất nhiệt tình!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 84.192,
          "at": 0.3,
          "duration": 4.152
        }
      ],
      "duration": 4.572
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Ăn cưới phải vui! Cả nhà cùng lắc lư theo điệu nhạc!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 88.524,
          "at": 0.3,
          "duration": 3.792
        }
      ],
      "duration": 4.212
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Bên trái một chút, bên phải một chút. Đừng giẫm váy em nha!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 92.496,
          "at": 0.3,
          "duration": 4.752
        }
      ],
      "duration": 5.172
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Xin dành một tràng pháo tay cho đội văn nghệ tự phát!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 97.428,
          "at": 0.3,
          "duration": 2.928
        }
      ],
      "duration": 3.348
    }
  ],
  "bedroom": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Đôi trẻ xin phép nghỉ một chút. Khách quý ở ngoài dùng trà nha!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 100.536,
          "at": 0.3,
          "duration": 4.08
        }
      ],
      "duration": 4.5
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Mọi người đừng trêu nữa, em đỏ mặt rồi nè!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 104.796,
          "at": 0.3,
          "duration": 3.312
        }
      ],
      "duration": 3.7319999999999998
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Đóng cửa nhẹ thôi. Ngoài kia cả họ đang nghe đó!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 108.288,
          "at": 0.3,
          "duration": 4.272
        }
      ],
      "duration": 4.692
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Phòng tân hôn đã sẵn sàng. Xin quý khách giữ khoảng cách với cửa phòng!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 112.74,
          "at": 0.3,
          "duration": 4.368
        }
      ],
      "duration": 4.788
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Khoan đã anh. Em còn chưa đếm xong phong bì!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 117.288,
          "at": 0.3,
          "duration": 3.864
        }
      ],
      "duration": 4.284
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Hôm nay mình nghỉ sớm. Mai còn đi trả đồ cưới nữa em!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 121.332,
          "at": 0.3,
          "duration": 4.584
        }
      ],
      "duration": 5.004
    }
  ],
  "claimGroom": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Xin chào chú rể mới! Mời anh bước lên sân khấu nhận vai!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 126.096,
          "at": 0.3,
          "duration": 4.104
        }
      ],
      "duration": 4.524
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Anh tới hơi trễ. Nhưng thương em thì anh tới đúng giờ.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 130.38,
          "at": 0.3,
          "duration": 4.44
        }
      ],
      "duration": 4.86
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Ghế chú rể đã có chủ. Ai muốn tranh tài thì dùng quà đổi vai nha!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 135,
          "at": 0.3,
          "duration": 4.512
        }
      ],
      "duration": 4.9319999999999995
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Vest đã chỉnh, tóc đã vuốt. Giờ chỉ còn đợi em gật đầu.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 139.692,
          "at": 0.3,
          "duration": 4.896
        }
      ],
      "duration": 5.316
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Cả nhà cho chú rể mới một tràng vỗ tay thật giòn!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 144.768,
          "at": 0.3,
          "duration": 2.976
        }
      ],
      "duration": 3.396
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Xin chào cả họ. Hôm nay con xin nhận trách nhiệm rửa chén!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 147.924,
          "at": 0.3,
          "duration": 4.728
        }
      ],
      "duration": 5.148
    }
  ],
  "claimBride": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Cô dâu của chúng ta đã tới! Xin mời em lên sân khấu!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 152.832,
          "at": 0.3,
          "duration": 4.008
        }
      ],
      "duration": 4.428
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Em tới rồi đây. Chú rể đứng thẳng lên cho em ngắm nào!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 157.02,
          "at": 0.3,
          "duration": 4.416
        }
      ],
      "duration": 4.836
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Một cô dâu xinh đẹp vừa xuất hiện. Cả nhà thả tim chúc mừng nào!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 161.616,
          "at": 0.3,
          "duration": 4.344
        }
      ],
      "duration": 4.764
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Váy cưới em đã mặc. Giờ chờ anh thể hiện thôi nha!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 166.14,
          "at": 0.3,
          "duration": 4.392
        }
      ],
      "duration": 4.812
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Xin dành lối đi giữa cho nhân vật chính của hôm nay!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 170.712,
          "at": 0.3,
          "duration": 2.952
        }
      ],
      "duration": 3.372
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Em không cần đám cưới đắt nhất. Em cần người thương em thật nhất!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 173.844,
          "at": 0.3,
          "duration": 4.584
        }
      ],
      "duration": 5.004
    }
  ],
  "replaceGroom": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Có biến ở hàng ghế chú rể! Xin chào nhân vật mới của buổi tiệc!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 178.608,
          "at": 0.3,
          "duration": 4.32
        }
      ],
      "duration": 4.74
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Ủa, mới quay đi một chút mà chú rể đã đổi người rồi!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 183.108,
          "at": 0.3,
          "duration": 3.648
        }
      ],
      "duration": 4.068
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Anh xin tiếp quản sân khấu. Nhạc cứ chạy, tình cứ tới!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 186.936,
          "at": 0.3,
          "duration": 4.872
        }
      ],
      "duration": 5.292
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Chú rể đổi người, tiệc vẫn tiếp tục. Bếp đừng dọn nha!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 191.988,
          "at": 0.3,
          "duration": 3.984
        }
      ],
      "duration": 4.404
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Anh mới tới nhớ học thuộc tên em trước nha!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 196.152,
          "at": 0.3,
          "duration": 3
        }
      ],
      "duration": 3.42
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Một màn đổi vai đầy bất ngờ! Cả nhà chào chú rể mới nào!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 199.332,
          "at": 0.3,
          "duration": 4.296
        }
      ],
      "duration": 4.716
    }
  ],
  "replaceBride": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Xin chào cô dâu mới! Sân khấu hôm nay lại thêm rực rỡ!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 203.808,
          "at": 0.3,
          "duration": 4.152
        }
      ],
      "duration": 4.572
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Anh vẫn đứng đây. Mà sao tim lại đập như lần đầu gặp em vậy?",
          "src": "sounds/wedding/voices.mp3",
          "offset": 208.14,
          "at": 0.3,
          "duration": 4.824
        }
      ],
      "duration": 5.244
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Em nhận vai rồi nha. Hoa cưới đưa đây em cầm cho!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 213.144,
          "at": 0.3,
          "duration": 4.416
        }
      ],
      "duration": 4.836
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Cô dâu đổi người, nhạc không đổi nhịp. Cả nhà tiếp tục chung vui!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 217.74,
          "at": 0.3,
          "duration": 4.416
        }
      ],
      "duration": 4.836
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Chú rể nhìn em nè. Đừng nhìn bàn đồ ăn nữa!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 222.336,
          "at": 0.3,
          "duration": 4.2
        }
      ],
      "duration": 4.62
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Xin mời cô dâu mới bước vào ánh đèn. Một tràng vỗ tay nào!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 226.716,
          "at": 0.3,
          "duration": 4.224
        }
      ],
      "duration": 4.644
    }
  ],
  "idle": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Khách quý cứ ngồi tự nhiên nha. Hôm nay ăn cưới online, vui là chính!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 231.12,
          "at": 0,
          "duration": 4.824
        }
      ],
      "duration": 5.244
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Có ai muốn lên làm chú rể không? Anh nhường sân khấu, không nhường phong bì!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 236.124,
          "at": 0,
          "duration": 5.4
        }
      ],
      "duration": 5.82
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Ai lên làm cô dâu cùng em không? Váy đẹp đã chuẩn bị sẵn rồi nè!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 241.704,
          "at": 0,
          "duration": 5.016
        }
      ],
      "duration": 5.436
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Bàn bên trái đâu rồi? Bàn bên phải đâu rồi? Cho đôi trẻ nghe tiếng vỗ tay nào!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 246.9,
          "at": 0,
