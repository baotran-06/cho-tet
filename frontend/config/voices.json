{
  "kiss": [
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Đứng yên. Đây là phúc lợi riêng của em.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 0.0,
          "at": 0.3,
          "duration": 4.488
        },
        {
          "role": "secretary",
          "text": "Dạ. Phúc lợi này có được quy ra tiền không sếp?",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 4.668,
          "at": 4.908,
          "duration": 4.08
        }
      ],
      "duration": 9.108
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Hợp đồng ghi rõ, em phải ở cạnh anh.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 8.928,
          "at": 0.3,
          "duration": 3.744
        },
        {
          "role": "secretary",
          "text": "Em nhớ hợp đồng chỉ ghi tám tiếng một ngày mà!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 12.852,
          "at": 4.164,
          "duration": 3.24
        }
      ],
      "duration": 7.524
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Em vừa được thưởng vì làm việc chăm chỉ.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 16.272,
          "at": 0.3,
          "duration": 3.408
        },
        {
          "role": "secretary",
          "text": "Thưởng thì chuyển khoản đi anh. Sao anh lại tiến tới?",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 19.86,
          "at": 3.828,
          "duration": 4.272
        }
      ],
      "duration": 8.22
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Cả công ty ra ngoài. Anh có chuyện riêng cần trao đổi.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 24.312,
          "at": 0.3,
          "duration": 5.088
        },
        {
          "role": "secretary",
          "text": "Anh ơi, cả công ty đang xem trực tiếp!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 29.58,
          "at": 5.508,
          "duration": 2.976
        }
      ],
      "duration": 8.604
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Trong công ty này, em chỉ cần nghe lời anh.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 32.736,
          "at": 0.3,
          "duration": 3.816
        },
        {
          "role": "secretary",
          "text": "Dạ. Nhưng lương tháng này, anh chuyển chưa?",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 36.732,
          "at": 4.236,
          "duration": 3.888
        }
      ],
      "duration": 8.244
    },
    {
      "lines": [
        {
          "role": "secretary",
          "text": "Sếp gọi em có việc gì ạ?",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 40.8,
          "at": 0.3,
          "duration": 2.472
        },
        {
          "role": "ceo",
          "text": "Có. Anh đang thiếu một người đứng thật gần.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 43.452,
          "at": 2.892,
          "duration": 4.416
        }
      ],
      "duration": 7.428
    }
  ],
  "wedding": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Thông báo! Công ty vừa sáp nhập hai trái tim.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 48.048,
          "at": 0.3,
          "duration": 4.008
        },
        {
          "role": "ceo",
          "text": "Từ hôm nay, anh giao cả đời này cho em.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 52.236,
          "at": 4.428,
          "duration": 3.792
        },
        {
          "role": "secretary",
          "text": "Dạ. Mật khẩu tài khoản anh giao luôn nha.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 56.208,
          "at": 8.34,
          "duration": 3.84
        }
      ],
      "duration": 12.3
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Họp khẩn! Tổng tài chuẩn bị ký hợp đồng trọn đời.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 60.228,
          "at": 0.3,
          "duration": 4.056
        },
        {
          "role": "ceo",
          "text": "Điều khoản duy nhất: em ở lại bên anh.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 64.464,
          "at": 4.476,
          "duration": 3.552
        },
        {
          "role": "secretary",
          "text": "Còn điều khoản của em: không được quên ngày kỷ niệm.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 68.196,
          "at": 8.148,
          "duration": 3.504
        }
      ],
      "duration": 11.772
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Xin mời phòng nhân sự chứng kiến buổi bổ nhiệm đặc biệt!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 71.88,
          "at": 0.3,
          "duration": 3.384
        },
        {
          "role": "ceo",
          "text": "Anh muốn em làm chủ cuộc đời anh.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 75.444,
          "at": 3.804,
          "duration": 3.192
        },
        {
          "role": "secretary",
          "text": "Vậy em xin nhận luôn quyền duyệt chi.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 78.816,
          "at": 7.116,
          "duration": 2.76
        }
      ],
      "duration": 9.996
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Từ đồng nghiệp thành người một nhà. Xin một tràng pháo tay!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 81.756,
          "at": 0.3,
          "duration": 4.368
        },
        {
          "role": "ceo",
          "text": "Cuối cùng, em cũng thuộc về gia đình anh.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 86.304,
          "at": 4.788,
          "duration": 3.576
        },
        {
          "role": "secretary",
          "text": "Nhưng việc nhà thì mình vẫn chia đôi nha.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 90.06,
          "at": 8.484,
          "duration": 2.88
        }
      ],
      "duration": 11.484
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Hôm nay tổng tài thôi tuyển dụng, chuyển sang cầu hôn!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 93.12,
          "at": 0.3,
          "duration": 3.528
        },
        {
          "role": "ceo",
          "text": "Anh đã tìm được người anh muốn giữ cả đời.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 96.828,
          "at": 3.948,
          "duration": 3.384
        },
        {
          "role": "secretary",
          "text": "Em đồng ý. Nhớ duyệt đơn nghỉ tuần trăng mật!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 100.392,
          "at": 7.452,
          "duration": 3.048
        }
      ],
      "duration": 10.62
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Lễ ký kết hạnh phúc bắt đầu! Hai bên đều không được hủy ngang.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 103.62,
          "at": 0.3,
          "duration": 4.752
        },
        {
          "role": "ceo",
          "text": "Anh hứa sẽ luôn chọn em.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 108.552,
          "at": 5.172,
          "duration": 2.64
        },
        {
          "role": "secretary",
          "text": "Em hứa sẽ nhắc anh chuyển tiền điện đúng hạn.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 111.372,
          "at": 7.932,
          "duration": 3.048
        }
      ],
      "duration": 11.1
    }
  ],
  "lieu": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Báo cáo! Có người bước vào với khí thế đòi kiểm tra nội bộ.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 114.6,
          "at": 0.3,
          "duration": 4.512
        },
        {
          "role": "lieu",
          "text": "Công ty tuyển thư ký, hay tuyển người yêu vậy?",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 119.292,
          "at": 4.932,
          "duration": 3.504
        },
        {
          "role": "secretary",
          "text": "Dạ, em chỉ đang tăng ca thôi chị!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 122.976,
          "at": 8.556,
          "duration": 3.0
        }
      ],
      "duration": 11.676
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Nhân vật mới vừa xuất hiện. Mùi drama đã tới trước người!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 126.156,
          "at": 0.3,
          "duration": 4.68
        },
        {
          "role": "lieu",
          "text": "Tôi vừa đi một lát, cô đã đứng gần anh ấy vậy rồi?",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 131.016,
          "at": 5.1,
          "duration": 3.936
        },
        {
          "role": "secretary",
          "text": "Dạ, vì chỗ xa không nghe rõ chỉ đạo ạ.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 135.132,
          "at": 9.156,
          "duration": 3.48
        }
      ],
      "duration": 12.756
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Phòng tiếp khách hôm nay có vẻ hơi nóng!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 138.792,
          "at": 0.3,
          "duration": 2.664
        },
        {
          "role": "lieu",
          "text": "Cô biết vị trí bên cạnh anh ấy là của ai không?",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 141.636,
          "at": 3.084,
          "duration": 3.672
        },
        {
          "role": "secretary",
          "text": "Dạ, sơ đồ công ty ghi chỗ này là chỗ thư ký.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 145.488,
          "at": 6.876,
          "duration": 3.864
        }
      ],
      "duration": 10.86
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Cảnh báo! Bão sắp đổ bộ vào bàn tổng tài.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 149.532,
          "at": 0.3,
          "duration": 3.936
        },
        {
          "role": "lieu",
          "text": "Cô tưởng đứng cạnh anh ấy là thành bà chủ sao?",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 153.648,
          "at": 4.356,
          "duration": 3.36
        },
        {
          "role": "secretary",
          "text": "Dạ không. Em vẫn đang chờ tăng lương thôi.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 157.188,
          "at": 7.836,
          "duration": 3.888
        }
      ],
      "duration": 11.844
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Bộ phận hóng chuyện xin phép làm thêm giờ!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 161.256,
          "at": 0.3,
          "duration": 2.856
        },
        {
          "role": "lieu",
          "text": "Cô tránh ra. Tôi có chuyện riêng với anh ấy.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 164.292,
          "at": 3.276,
          "duration": 4.368
        },
        {
          "role": "secretary",
          "text": "Dạ, chị đặt lịch chưa để em kiểm tra?",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 168.84,
          "at": 7.764,
          "duration": 3.192
        }
      ],
      "duration": 11.076
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Có vị khách mang theo cả áp suất thấp vào công ty!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 172.212,
          "at": 0.3,
          "duration": 3.12
        },
        {
          "role": "lieu",
          "text": "Tôi nhớ mình chưa cho phép cô thân thiết như vậy.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 175.512,
          "at": 3.54,
          "duration": 3.288
        },
        {
          "role": "secretary",
          "text": "Dạ, quyền phê duyệt của chị nằm ở phòng nào ạ?",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 178.98,
          "at": 6.948,
          "duration": 3.528
        }
      ],
      "duration": 10.596
    }
  ],
  "replaceCeo": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Chú ý! Ghế nóng chuẩn bị đổi phong cách lãnh đạo.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 182.688,
          "at": 0.3,
          "duration": 4.032
        },
        {
          "role": "ceo",
          "text": "Tổng tài mới tới. Báo cáo ngắn, lương thưởng nói dài.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 186.9,
          "at": 4.452,
          "duration": 5.688
        }
      ],
      "duration": 10.26
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Hội đồng quản trị vừa bấm nút thay đổi diện mạo!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 192.768,
          "at": 0.3,
          "duration": 3.072
        },
        {
          "role": "ceo",
          "text": "Tôi thay bộ vest. Còn khí chất thì không cần thay.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 196.02,
          "at": 3.492,
          "duration": 4.944
        }
      ],
      "duration": 8.556
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Bản cập nhật tổng tài đã hoàn tất!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 201.144,
          "at": 0.3,
          "duration": 2.544
        },
        {
          "role": "ceo",
          "text": "Từ giờ, công ty này làm việc bằng thực lực. Và một chút đẹp trai.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 203.868,
          "at": 2.964,
          "duration": 5.952
        }
      ],
      "duration": 9.036
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Lãnh đạo tái xuất với phong cách mới!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 210.0,
          "at": 0.3,
          "duration": 2.712
        },
        {
          "role": "ceo",
          "text": "Mọi người cứ bình tĩnh. Người nhiều tiền thường tới hơi muộn.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 212.892,
          "at": 3.132,
          "duration": 5.664
        }
      ],
      "duration": 8.916
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Tổng tài đã trở lại. Phòng kế toán bắt đầu hồi hộp!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 218.736,
          "at": 0.3,
          "duration": 4.344
        },
        {
          "role": "ceo",
          "text": "Tôi đổi phong cách, không đổi lời hứa tăng lương. Để mai tính.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 223.26,
          "at": 4.764,
          "duration": 5.76
        }
      ],
      "duration": 10.644
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Một diện mạo mới vừa bước lên ghế lãnh đạo!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 229.2,
          "at": 0.3,
          "duration": 3.12
        },
        {
          "role": "ceo",
          "text": "Ai gọi tôi lên? Báo trước, tôi không duyệt đơn nghỉ hóng chuyện.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 232.5,
          "at": 3.54,
          "duration": 5.76
        }
      ],
      "duration": 9.42
    }
  ],
  "replaceSecretary": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Phòng nhân sự thông báo: thư ký vừa đổi phong cách!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 238.44,
          "at": 0.3,
          "duration": 3.384
        },
        {
          "role": "secretary",
          "text": "Em mới tới. Hồ sơ, lịch họp và tin đồn em đều nắm rõ.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 242.004,
          "at": 3.804,
          "duration": 5.328
        }
      ],
      "duration": 9.252
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Một diện mạo mới xuất hiện bên cạnh tổng tài!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 247.512,
          "at": 0.3,
          "duration": 3.072
        },
        {
          "role": "secretary",
          "text": "Em đổi trang phục thôi. Hóa đơn chưa thanh toán em vẫn nhớ.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 250.764,
          "at": 3.492,
          "duration": 4.68
        }
      ],
      "duration": 8.292
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Thư ký đã sẵn sàng nhận bàn giao!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 255.624,
          "at": 0.3,
          "duration": 2.616
        },
        {
          "role": "secretary",
          "text": "Việc khó cứ giao em. Còn việc tăng lương, em giao sếp.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 258.42,
          "at": 3.036,
          "duration": 4.728
        }
      ],
      "duration": 7.884
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Bộ phận điều hành vừa có bản cập nhật mới!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 263.328,
          "at": 0.3,
          "duration": 2.904
        },
        {
          "role": "secretary",
          "text": "Lịch hôm nay kín rồi. Chỉ còn trống lịch sếp chuyển lương.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 266.412,
          "at": 3.324,
          "duration": 4.392
        }
      ],
      "duration": 7.836
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Xin chào thư ký với phong cách mới của công ty!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 270.984,
          "at": 0.3,
          "duration": 3.072
        },
        {
          "role": "secretary",
          "text": "Em làm việc rất chuyên nghiệp. Đặc biệt là lúc đúng giờ tan ca.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 274.236,
          "at": 3.492,
          "duration": 4.776
        }
      ],
      "duration": 8.388
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Thư ký mới bước vào. Công ty bỗng gọn gàng hơn hẳn!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 279.192,
          "at": 0.3,
          "duration": 4.44
        },
        {
          "role": "secretary",
          "text": "Từ giờ, ai gặp sếp nhớ đặt lịch. Kể cả sếp muốn gặp em.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 283.812,
          "at": 4.86,
          "duration": 5.016
        }
      ],
      "duration": 9.996
    }
  ],
  "claimCeo": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Một nhân viên vừa bước lên nhận ghế tổng tài!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 289.008,
          "at": 0.3,
          "duration": 3.144
        },
        {
          "role": "ceo",
          "text": "Ai muốn ngồi ghế này thì bước lên đối đầu với tôi.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 292.332,
          "at": 3.564,
          "duration": 3.768
        }
      ],
      "duration": 7.452
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Thang máy sự nghiệp vừa chạy thẳng lên tầng cao nhất!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 296.28,
          "at": 0.3,
          "duration": 3.144
        },
        {
          "role": "ceo",
          "text": "Từ nay, tôi là người ký giấy. Còn ai làm giấy thì tính sau.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 299.604,
          "at": 3.564,
          "duration": 5.928
        }
      ],
      "duration": 9.612
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Cả công ty chào đón vị tổng tài vừa được bổ nhiệm!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 305.712,
          "at": 0.3,
          "duration": 3.216
        },
        {
          "role": "ceo",
          "text": "Tôi không thích nói nhiều. Ai rảnh thì pha giúp tôi ly cà phê.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 309.108,
          "at": 3.636,
          "duration": 5.64
        }
      ],
      "duration": 9.396
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Chúc mừng nhân viên đã thăng chức thành tổng tài!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 314.928,
          "at": 0.3,
          "duration": 2.952
        },
        {
          "role": "ceo",
          "text": "Hồi nãy còn gõ báo cáo. Giờ tôi duyệt luôn báo cáo của mình.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 318.06,
          "at": 3.372,
          "duration": 5.808
        }
      ],
      "duration": 9.3
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Ghế tổng tài chính thức có người nhận rồi!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 324.048,
          "at": 0.3,
          "duration": 2.736
        },
        {
          "role": "ceo",
          "text": "Trời lạnh rồi. Công ty mình phát áo ấm trước, chuyện bá đạo để sau.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 326.964,
          "at": 3.156,
          "duration": 6.336
        }
      ],
      "duration": 9.612
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Quyết định bổ nhiệm đã có hiệu lực!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 333.48,
          "at": 0.3,
          "duration": 2.4
        },
        {
          "role": "ceo",
          "text": "Mục tiêu của tôi rất đơn giản: công ty phát triển, thư ký đừng nghỉ.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 336.06,
          "at": 2.82,
          "duration": 5.568
        }
      ],
      "duration": 8.508
    }
  ],
  "claimSecretary": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Một nhân viên đang bước lên nhận vị trí thư ký!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 341.808,
          "at": 0.3,
          "duration": 3.192
        },
        {
          "role": "secretary",
          "text": "Em xin nhận việc. Xin sếp đừng giao em cả việc yêu đương.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 345.18,
          "at": 3.612,
          "duration": 4.608
        }
      ],
      "duration": 8.34
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Vị trí bên cạnh tổng tài vừa có người nhận!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 349.968,
          "at": 0.3,
          "duration": 3.072
        },
        {
          "role": "secretary",
          "text": "Em quản lịch họp, hồ sơ và cả lịch sếp nhớ chuyển lương.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 353.22,
          "at": 3.492,
          "duration": 3.888
        }
      ],
      "duration": 7.5
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Thư ký của tổng tài đã có chủ nhân mới!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 357.288,
          "at": 0.3,
          "duration": 2.856
        },
        {
          "role": "secretary",
          "text": "Từ hôm nay, ai muốn gặp sếp xin đi qua em trước.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 360.324,
          "at": 3.276,
          "duration": 3.528
        }
      ],
      "duration": 6.924
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Đơn xin thăng chức đã được duyệt!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 364.032,
          "at": 0.3,
          "duration": 2.4
        },
        {
          "role": "secretary",
          "text": "Em đã chuẩn bị sẵn báo cáo. Và đơn đề nghị tăng phụ cấp.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 366.612,
          "at": 2.82,
          "duration": 4.896
        }
      ],
      "duration": 7.836
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Công ty chào đón người giữ lịch trình của tổng tài!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 371.688,
          "at": 0.3,
          "duration": 3.12
        },
        {
          "role": "secretary",
          "text": "Em nhận việc vì đam mê. Đam mê thấy tiền lương vào tài khoản.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 374.988,
          "at": 3.54,
          "duration": 4.944
        }
      ],
      "duration": 8.604
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Nhân viên vừa đổi bàn. Sự nghiệp cũng đổi luôn!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 380.112,
          "at": 0.3,
          "duration": 4.032
        },
        {
          "role": "secretary",
          "text": "Sếp yên tâm, em rất kín miệng. Trừ những chuyện cả công ty đã biết.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 384.324,
          "at": 4.452,
          "duration": 5.232
        }
      ],
      "duration": 9.804
    }
  ],
  "bedroom": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Lịch họp kết thúc. Hai nhân vật chính xin phép nghỉ riêng một chút!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 389.736,
          "at": 0.3,
          "duration": 4.584
        },
        {
          "role": "ceo",
          "text": "Hôm nay không tiếp khách. Chuyện công ty để ngày mai.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 394.5,
          "at": 5.004,
          "duration": 4.872
        }
      ],
      "duration": 9.996
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Chế độ riêng tư đã bật. Xin quý vị giữ khoảng cách với cánh cửa!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 399.552,
          "at": 0.3,
          "duration": 4.968
        },
        {
          "role": "ceo",
          "text": "Anh đã tắt điện thoại. Trừ số của kế toán, lỡ còn tiền về.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 404.7,
          "at": 5.388,
          "duration": 6.168
        }
      ],
      "duration": 11.676
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Phòng riêng đang được sử dụng. Bộ phận hóng chuyện xin chờ bên ngoài!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 411.048,
          "at": 0.3,
          "duration": 4.824
        },
        {
          "role": "ceo",
          "text": "Không nhận lịch họp, không nhận báo cáo. Anh cần yên tĩnh.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 416.052,
          "at": 5.244,
          "duration": 5.664
        }
      ],
      "duration": 11.028
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Hai người tạm rời văn phòng. Cửa đã khép, xin đừng làm phiền!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 421.896,
          "at": 0.3,
          "duration": 4.68
        },
        {
          "role": "ceo",
          "text": "Anh chỉ nghỉ một lát. Đừng ai tranh thủ đổi luôn ghế của anh.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 426.756,
          "at": 5.1,
          "duration": 5.568
        }
      ],
      "duration": 10.788
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Thông báo nội bộ: cuộc họp riêng đã bắt đầu!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 432.504,
          "at": 0.3,
          "duration": 3.072
        },
        {
          "role": "ceo",
          "text": "Việc quan trọng nhất bây giờ là nghỉ ngơi. Mọi người giải tán.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 435.756,
          "at": 3.492,
          "duration": 5.712
        }
      ],
      "duration": 9.324
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Tổng tài đã chuyển sang chế độ không làm phiền!",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 441.648,
          "at": 0.3,
          "duration": 2.952
        },
        {
          "role": "ceo",
          "text": "Anh đặt biển ngoài cửa rồi. Ai gõ cửa nhớ có lý do thật thuyết phục.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 444.78,
          "at": 3.372,
          "duration": 5.88
        }
      ],
      "duration": 9.372
    }
  ],
  "fire": [
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Cô bị sa thải.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 450.84,
          "at": 0.3,
          "duration": 2.304
        }
      ],
      "duration": 2.724
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Cô có thể nghỉ việc rồi.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 453.324,
          "at": 0.3,
          "duration": 2.52
        }
      ],
      "duration": 2.94
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Từ hôm nay, cô không cần đến nữa.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 456.024,
          "at": 0.3,
          "duration": 3.432
        }
      ],
      "duration": 3.852
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Bàn giao công việc rồi rời đi.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 459.636,
          "at": 0.3,
          "duration": 2.904
        }
      ],
      "duration": 3.324
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Quyết định của tôi là chấm dứt hợp đồng.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 462.72,
          "at": 0.3,
          "duration": 3.216
        }
      ],
      "duration": 3.636
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Cô ra ngoài đi. Hợp đồng kết thúc.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 466.116,
          "at": 0.3,
          "duration": 4.248
        }
      ],
      "duration": 4.668
    }
  ],
  "idleBoth": [
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Ai muốn làm tổng tài thì bước lên đối đầu với ta. Đừng gửi mỗi ánh mắt.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 470.544,
          "at": 0,
          "duration": 6.24
        }
      ],
      "duration": 6.36
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Trời lạnh rồi. Ta định cho một tập đoàn phá sản. Nhưng nhớ ra mình chưa trả tiền điện.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 476.964,
          "at": 0,
          "duration": 8.136
        }
      ],
      "duration": 8.256
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Ghế tổng tài còn trống, ghế thư ký cũng còn. Công ty đông thế mà chưa ai muốn thăng chức sao?",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 485.28,
          "at": 0,
          "duration": 7.92
        }
      ],
      "duration": 8.04
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Ta có tất cả, chỉ thiếu một thư ký chịu nhắc ta đi họp đúng giờ.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 493.38,
          "at": 0,
          "duration": 5.112
        }
      ],
      "duration": 5.232
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Thư ký đâu? Mang hợp đồng tới. Khoan, mang luôn bảng lương để ta biết công ty còn tiền không.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 498.672,
          "at": 0,
          "duration": 8.736
        }
      ],
      "duration": 8.856
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Ta không thiếu tiền. Ta chỉ thiếu người dám ngồi vào cái ghế này.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 507.588,
          "at": 0,
          "duration": 5.664
        }
      ],
      "duration": 5.784
    }
  ],
  "idleCeo": [
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Thư ký đã có người rồi. Ai muốn làm tổng tài thì đừng để chiếc ghế này nguội.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 513.432,
          "at": 0,
          "duration": 6.264
        }
      ],
      "duration": 6.384
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Ghế tổng tài đang trống. Ai lên nhận đi, chứ ta tự duyệt báo cáo mãi cũng ngại.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 519.876,
          "at": 0,
          "duration": 7.056
        }
      ],
      "duration": 7.176
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Công ty cần người lãnh đạo. Đẹp trai là lợi thế, biết trả lương là ưu tiên.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 527.112,
          "at": 0,
          "duration": 6.792
        }
      ],
      "duration": 6.912
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Ai dám thay ta điều hành công ty? Có thư ký hỗ trợ rồi, đừng sợ bảng tính.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 534.084,
          "at": 0,
          "duration": 6.696
        }
      ],
      "duration": 6.816
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Ta chờ một đối thủ xứng tầm. Còn ghế thì chờ một người chịu ngồi.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 540.96,
          "at": 0,
          "duration": 5.976
        }
      ],
      "duration": 6.096
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Vị trí tổng tài còn trống. Ai lên trước thì được nghe thư ký nhắc lịch họp trước.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 547.116,
          "at": 0,
          "duration": 6.624
        }
      ],
      "duration": 6.744
    }
  ],
  "idleSecretary": [
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Tổng tài đã có rồi. Ai muốn đứng cạnh anh thì lên nhận vị trí thư ký đi.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 553.92,
          "at": 0,
          "duration": 6.264
        }
      ],
      "duration": 6.384
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Anh cần một thư ký. Ưu tiên người biết nhắc anh ăn cơm, không chỉ nhắc thanh toán.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 560.364,
          "at": 0,
          "duration": 6.864
        }
      ],
      "duration": 6.984
    },
    {
      "lines": [
        {
          "role": "ceo",
          "text": "Ghế thư ký còn trống. Lương có thể thương lượng, còn độ bá đạo thì có sẵn.",
          "src": "sounds/office/voices-v3.mp3",
          "offset": 567.408,
          "at": 0,
          "duration": 6.816
        }
      ],
      "duration": 6.936
    },
    {
      "lines": [
        {
          "role": "ceo",
