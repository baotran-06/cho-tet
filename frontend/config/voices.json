{
  "kiss": [
    {
      "lines": [
        {
          "role": "groom",
          "text": "Cho anh mượn má một chút. Anh trả bằng cả tấm lòng.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 0.0,
          "at": 0.3,
          "duration": 4.32
        }
      ],
      "duration": 4.74
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Hôn nhẹ thôi anh, lớp nền này em đánh cả tiếng đó.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 4.5,
          "at": 0.3,
          "duration": 3.672
        }
      ],
      "duration": 4.092
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Má đã hồng, tim đã rung. Cả nhà cho đôi trẻ một tràng vỗ tay!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 8.352,
          "at": 0.3,
          "duration": 5.184
        }
      ],
      "duration": 5.604
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Anh không giỏi thả thính. Anh chỉ giỏi thương em.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 13.716,
          "at": 0.3,
          "duration": 4.104
        }
      ],
      "duration": 4.524
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Được rồi, em nhận nụ hôn. Còn trà sữa anh vẫn nợ nha.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 18.0,
          "at": 0.3,
          "duration": 4.896
        }
      ],
      "duration": 5.316
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Xin giữ bình tĩnh! Đây là đám cưới, không phải cuộc thi phát đường.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 23.076,
          "at": 0.3,
          "duration": 5.112
        }
      ],
      "duration": 5.532
    }
  ],
  "wedding": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Xin mời cả nhà hướng về sân khấu. Lễ thành hôn chính thức bắt đầu!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 28.368,
          "at": 0.3,
          "duration": 4.92
        }
      ],
      "duration": 5.34
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Từ hôm nay, tiền lương anh có nơi để về rồi.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 33.468,
          "at": 0.3,
          "duration": 3.216
        }
      ],
      "duration": 3.636
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Em đồng ý. Riêng mật khẩu điện thoại, mình bàn sau nha.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 36.864,
          "at": 0.3,
          "duration": 3.768
        }
      ],
      "duration": 4.188
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Một người trao nhẫn, một người trao cả thanh xuân. Xin chúc mừng đôi uyên ương!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 40.812,
          "at": 0.3,
          "duration": 5.616
        }
      ],
      "duration": 6.036
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Trước bao nhiêu người ở đây, anh chọn em. Hôm nay và cả những ngày sau.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 46.608,
          "at": 0.3,
          "duration": 5.232
        }
      ],
      "duration": 5.652
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Vậy từ mai anh rửa chén, em đứng cạnh cổ vũ nha.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 52.02,
          "at": 0.3,
          "duration": 3.72
        }
      ],
      "duration": 4.14
    }
  ],
  "bouquet": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Hội độc thân đâu rồi? Hoa cưới chuẩn bị cất cánh!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 55.92,
          "at": 0.3,
          "duration": 4.032
        }
      ],
      "duration": 4.452
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Em tung hoa thôi, không tung người yêu đâu nha!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 60.132,
          "at": 0.3,
          "duration": 3.24
        }
      ],
      "duration": 3.66
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Ai bắt được hoa, nhớ mời cả phòng này đi ăn cưới đó!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 63.552,
          "at": 0.3,
          "duration": 3.672
        }
      ],
      "duration": 4.092
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Ba, hai, một! Duyên tới thì mình đừng né nha!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 67.404,
          "at": 0.3,
          "duration": 4.488
        }
      ],
      "duration": 4.908
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Bắt hoa bằng tay, đừng bắt bằng đầu nha cả nhà!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 72.072,
          "at": 0.3,
          "duration": 3.384
        }
      ],
      "duration": 3.804
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Hoa đã lên đường. Tình yêu đang tìm địa chỉ giao hàng!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 75.636,
          "at": 0.3,
          "duration": 4.224
        }
      ],
      "duration": 4.644
    }
  ],
  "celebrate": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Nhạc lên! Bàn nào vui nhất cho tôi thấy cánh tay nào!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 80.04,
          "at": 0.3,
          "duration": 4.104
        }
      ],
      "duration": 4.524
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Hôm nay vui quá, cô dâu xin phép quên luôn dáng dịu dàng!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 84.324,
          "at": 0.3,
          "duration": 3.72
        }
      ],
      "duration": 4.14
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Anh nhảy không đẹp. Nhưng được cái anh rất nhiệt tình!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 88.224,
          "at": 0.3,
          "duration": 4.152
        }
      ],
      "duration": 4.572
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Ăn cưới phải vui! Cả nhà cùng lắc lư theo điệu nhạc!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 92.556,
          "at": 0.3,
          "duration": 4.152
        }
      ],
      "duration": 4.572
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Bên trái một chút, bên phải một chút. Đừng giẫm váy em nha!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 96.888,
          "at": 0.3,
          "duration": 4.752
        }
      ],
      "duration": 5.172
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Xin dành một tràng pháo tay cho đội văn nghệ tự phát!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 101.82,
          "at": 0.3,
          "duration": 3.24
        }
      ],
      "duration": 3.66
    }
  ],
  "bedroom": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Đôi trẻ xin phép nghỉ một chút. Khách quý ở ngoài dùng trà nha!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 105.24,
          "at": 0.3,
          "duration": 4.608
        }
      ],
      "duration": 5.028
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Mọi người đừng trêu nữa, em đỏ mặt rồi nè!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 110.028,
          "at": 0.3,
          "duration": 3.312
        }
      ],
      "duration": 3.732
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Đóng cửa nhẹ thôi. Ngoài kia cả họ đang nghe đó!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 113.52,
          "at": 0.3,
          "duration": 4.272
        }
      ],
      "duration": 4.692
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Phòng tân hôn đã sẵn sàng. Xin quý khách giữ khoảng cách với cửa phòng!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 117.972,
          "at": 0.3,
          "duration": 4.944
        }
      ],
      "duration": 5.364
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Khoan đã anh. Em còn chưa đếm xong phong bì!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 123.096,
          "at": 0.3,
          "duration": 3.864
        }
      ],
      "duration": 4.284
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Hôm nay mình nghỉ sớm. Mai còn đi trả đồ cưới nữa em!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 127.14,
          "at": 0.3,
          "duration": 4.584
        }
      ],
      "duration": 5.004
    }
  ],
  "claimGroom": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Xin chào chú rể mới! Mời anh bước lên sân khấu nhận vai!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 131.904,
          "at": 0.3,
          "duration": 4.8
        }
      ],
      "duration": 5.22
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Anh tới hơi trễ. Nhưng thương em thì anh tới đúng giờ.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 136.884,
          "at": 0.3,
          "duration": 4.44
        }
      ],
      "duration": 4.86
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Ghế chú rể đã có chủ. Ai muốn tranh tài thì dùng quà đổi vai nha!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 141.504,
          "at": 0.3,
          "duration": 5.064
        }
      ],
      "duration": 5.484
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Vest đã chỉnh, tóc đã vuốt. Giờ chỉ còn đợi em gật đầu.",
          "src": "sounds/wedding/voices.mp3",
          "offset": 146.748,
          "at": 0.3,
          "duration": 4.896
        }
      ],
      "duration": 5.316
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Cả nhà cho chú rể mới một tràng vỗ tay thật giòn!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 151.824,
          "at": 0.3,
          "duration": 3.168
        }
      ],
      "duration": 3.588
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Xin chào cả họ. Hôm nay con xin nhận trách nhiệm rửa chén!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 155.172,
          "at": 0.3,
          "duration": 4.728
        }
      ],
      "duration": 5.148
    }
  ],
  "claimBride": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Cô dâu của chúng ta đã tới! Xin mời em lên sân khấu!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 160.08,
          "at": 0.3,
          "duration": 4.512
        }
      ],
      "duration": 4.932
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Em tới rồi đây. Chú rể đứng thẳng lên cho em ngắm nào!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 164.772,
          "at": 0.3,
          "duration": 4.416
        }
      ],
      "duration": 4.836
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Một cô dâu xinh đẹp vừa xuất hiện. Cả nhà thả tim chúc mừng nào!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 169.368,
          "at": 0.3,
          "duration": 4.824
        }
      ],
      "duration": 5.244
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Váy cưới em đã mặc. Giờ chờ anh thể hiện thôi nha!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 174.372,
          "at": 0.3,
          "duration": 4.392
        }
      ],
      "duration": 4.812
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Xin dành lối đi giữa cho nhân vật chính của hôm nay!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 178.944,
          "at": 0.3,
          "duration": 3.264
        }
      ],
      "duration": 3.684
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Em không cần đám cưới đắt nhất. Em cần người thương em thật nhất!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 182.388,
          "at": 0.3,
          "duration": 4.584
        }
      ],
      "duration": 5.004
    }
  ],
  "replaceGroom": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Có biến ở hàng ghế chú rể! Xin chào nhân vật mới của buổi tiệc!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 187.152,
          "at": 0.3,
          "duration": 4.872
        }
      ],
      "duration": 5.292
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Ủa, mới quay đi một chút mà chú rể đã đổi người rồi!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 192.204,
          "at": 0.3,
          "duration": 3.648
        }
      ],
      "duration": 4.068
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Anh xin tiếp quản sân khấu. Nhạc cứ chạy, tình cứ tới!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 196.032,
          "at": 0.3,
          "duration": 4.872
        }
      ],
      "duration": 5.292
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Chú rể đổi người, tiệc vẫn tiếp tục. Bếp đừng dọn nha!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 201.084,
          "at": 0.3,
          "duration": 4.536
        }
      ],
      "duration": 4.956
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Anh mới tới nhớ học thuộc tên em trước nha!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 205.8,
          "at": 0.3,
          "duration": 3.0
        }
      ],
      "duration": 3.42
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Một màn đổi vai đầy bất ngờ! Cả nhà chào chú rể mới nào!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 208.98,
          "at": 0.3,
          "duration": 4.512
        }
      ],
      "duration": 4.932
    }
  ],
  "replaceBride": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Xin chào cô dâu mới! Sân khấu hôm nay lại thêm rực rỡ!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 213.672,
          "at": 0.3,
          "duration": 4.656
        }
      ],
      "duration": 5.076
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Anh vẫn đứng đây. Mà sao tim lại đập như lần đầu gặp em vậy?",
          "src": "sounds/wedding/voices.mp3",
          "offset": 218.508,
          "at": 0.3,
          "duration": 4.824
        }
      ],
      "duration": 5.244
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Em nhận vai rồi nha. Hoa cưới đưa đây em cầm cho!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 223.512,
          "at": 0.3,
          "duration": 4.416
        }
      ],
      "duration": 4.836
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Cô dâu đổi người, nhạc không đổi nhịp. Cả nhà tiếp tục chung vui!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 228.108,
          "at": 0.3,
          "duration": 4.92
        }
      ],
      "duration": 5.34
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Chú rể nhìn em nè. Đừng nhìn bàn đồ ăn nữa!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 233.208,
          "at": 0.3,
          "duration": 4.2
        }
      ],
      "duration": 4.62
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Xin mời cô dâu mới bước vào ánh đèn. Một tràng vỗ tay nào!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 237.588,
          "at": 0.3,
          "duration": 4.776
        }
      ],
      "duration": 5.196
    }
  ],
  "idle": [
    {
      "lines": [
        {
          "role": "mc",
          "text": "Khách quý cứ ngồi tự nhiên nha. Hôm nay ăn cưới online, vui là chính!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 242.544,
          "at": 0,
          "duration": 5.472
        }
      ],
      "duration": 5.592
    },
    {
      "lines": [
        {
          "role": "groom",
          "text": "Có ai muốn lên làm chú rể không? Anh nhường sân khấu, không nhường phong bì!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 248.196,
          "at": 0,
          "duration": 5.4
        }
      ],
      "duration": 5.52
    },
    {
      "lines": [
        {
          "role": "bride",
          "text": "Ai lên làm cô dâu cùng em không? Váy đẹp đã chuẩn bị sẵn rồi nè!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 253.776,
          "at": 0,
          "duration": 5.016
        }
      ],
      "duration": 5.136
    },
    {
      "lines": [
        {
          "role": "mc",
          "text": "Bàn bên trái đâu rồi? Bàn bên phải đâu rồi? Cho đôi trẻ nghe tiếng vỗ tay nào!",
          "src": "sounds/wedding/voices.mp3",
          "offset": 258.972,
          "at": 0,
          "duration": 6.336
        }
